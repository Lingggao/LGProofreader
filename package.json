{
  "name": "lg-proofreader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "icon": "./icon.png",
  "description": "Ling Gao 校对员 — newspaper page layout analysis and multi-role proofreading for DeepSeek Harness.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "prompts",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs",
    "detail": "node scripts/detail.mjs",
    "release": "node scripts/release.mjs",
    "package:release": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
